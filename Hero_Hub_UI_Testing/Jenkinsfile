pipeline {
    agent any
    
    tools {
        maven 'Maven_3.x'
        jdk 'Java_11'
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('Execute Automation Suites') {
            steps {
                // Fixed: Explicitly changes directory into your subfolder before running Maven
                dir('Hero_Hub_UI_Testing') {
                    bat 'mvn clean test'
                }
            }
        }
    }
    
    post {
        always {
            // Fixed: Adjusted reporting paths to match your project subfolder layout
            archiveArtifacts artifacts: 'Hero_Hub_UI_Testing/Reports/**/*', fingerprint: true
            junit 'Hero_Hub_UI_Testing/target/surefire-reports/*.xml'
        }
    }
}
