pipeline {
    agent any
    
    tools {
        maven 'Maven_3.x'
        jdk 'Java_11'
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('Execute Automation Suites') {
            steps {
                dir('Hero_Hub_UI_Testing') {
                    bat 'mvn clean test'
                }
            }
        }
    }
    
    post {
        always {
            // 💡 FIXED: Uses double wildcards (**/) so Jenkins can look deep inside your subfolders for reports
            archiveArtifacts artifacts: '**/Reports/**/*', fingerprint: true, allowEmptyArchive: true
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
